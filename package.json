{
  "name": "slides-capture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Capture published Google Slides as high-resolution PNGs and send them to PDF24.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
